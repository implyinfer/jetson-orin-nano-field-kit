# Reachy Mini Control App Configuration
# Copy this file to .env and update the values as needed

# === Reachy Connection ===
# IP address of the Reachy Mini robot
REACHY_HOST=192.168.1.100
# Reachy SDK port (default is usually 50051 for gRPC)
REACHY_PORT=50051
# Connection timeout in seconds
REACHY_TIMEOUT=10

# === Web Server ===
# Port for the web dashboard (unique to avoid conflicts)
WEB_PORT=8080
# Host interface to bind to (0.0.0.0 for all interfaces)
WEB_HOST=0.0.0.0
# Enable debug mode (true/false)
DEBUG=false

# === WebRTC Streaming ===
# WebRTC port for video streaming
WEBRTC_PORT=8081
# Video resolution (format: WIDTHxHEIGHT)
VIDEO_RESOLUTION=1280x720
# Video frame rate
VIDEO_FPS=30
# Video codec (h264, vp8, vp9)
VIDEO_CODEC=h264
# Enable hardware acceleration on Jetson (true/false)
HARDWARE_ACCELERATION=true

# === Camera Configuration ===
# Camera device index (usually 0 for first camera)
CAMERA_DEVICE=0
# Camera format (mjpeg, yuyv, nv12)
CAMERA_FORMAT=mjpeg
# Use Reachy's built-in cameras if available (true/false)
USE_REACHY_CAMERAS=true

# === Robot Control ===
# Enable safety limits (highly recommended: true)
SAFETY_LIMITS=true
# Maximum joint velocity (degrees/second)
MAX_JOINT_VELOCITY=50.0
# Maximum torque limit (0.0-1.0)
MAX_TORQUE_LIMIT=0.8
# Auto-compliance when idle (true/false)
AUTO_COMPLIANCE=true
# Idle timeout before enabling compliance (seconds)
IDLE_TIMEOUT=30

# === Entertainment Macros ===
# Enable macro commands (true/false)
ENABLE_MACROS=true
# Macro execution timeout (seconds)
MACRO_TIMEOUT=60
# Available macro names (comma-separated)
AVAILABLE_MACROS=wave,dance,look_around,nod,shake_head,point,celebrate

# === System Monitoring ===
# Enable system resource monitoring (true/false)
ENABLE_MONITORING=true
# Monitoring update interval (seconds)
MONITORING_INTERVAL=5
# CPU temperature warning threshold (Celsius)
CPU_TEMP_WARNING=75
# Memory usage warning threshold (percentage)
MEMORY_WARNING=85

# === Logging ===
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Enable file logging (true/false)
LOG_TO_FILE=true
# Log file path (relative to app directory)
LOG_FILE=logs/reachy-mini.log
# Maximum log file size (MB)
MAX_LOG_SIZE=10

# === Security ===
# Enable authentication for web interface (true/false)
ENABLE_AUTH=false
# Secret key for session management (generate a secure random string)
SECRET_KEY=your-secret-key-here
# Allowed origins for CORS (comma-separated, * for all)
ALLOWED_ORIGINS=*

# === Integration ===
# MediaMTX RTSP server URL (if using existing setup)
MEDIAMTX_URL=rtsp://localhost:8554/reachy
# LiveKit server URL (if using LiveKit instead of WebRTC)
LIVEKIT_URL=ws://localhost:7880
# MQTT broker for external communication (optional)
MQTT_BROKER=localhost:1883

# === Performance ===
# Number of worker threads for video processing
VIDEO_WORKERS=2
# Frame buffer size for video streaming
FRAME_BUFFER_SIZE=10
# Enable async processing (true/false)
ASYNC_PROCESSING=true
# WebRTC connection timeout (seconds)
WEBRTC_TIMEOUT=30

# === Development ===
# Enable hot reload for development (true/false)
HOT_RELOAD=false
# Enable CORS for development (true/false)
DEV_CORS=true
# Static file directory for web assets
STATIC_DIR=static
# Template directory for HTML templates
TEMPLATE_DIR=templates